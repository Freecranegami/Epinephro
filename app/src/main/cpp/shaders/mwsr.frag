layout(set = 0, binding = 0) uniform sampler2D uTex;
layout(push_constant) uniform PC {
    highp vec4 ViewportInfo;   // 1/w, 1/h, w, h of the input
    highp vec4 t0;             // output/input scale x, y, kc, ft
    highp vec4 t1;             // kg, kwc, kl, kr
} pc;
layout(location = 0) in highp vec2 vUv;
layout(location = 0) out vec4 oColor;

vec3 S(vec2 uv) { return textureLod(uTex, uv, 0.0).rgb; }
const vec3 LUMA = vec3(0.25, 0.625, 0.125);

void main() {
    vec2 uv = vUv;
    vec2 texel = pc.ViewportInfo.xy;
    vec2 sp = uv * pc.ViewportInfo.zw;
    vec2 f0 = floor(sp - 0.5);
    vec2 t = sp - 0.5 - f0;
    vec2 s = 1.0 - t;
    vec2 ku = pc.t0.z * t * s;
    vec2 w12 = 1.0 + ku;
    vec2 p12 = (f0 + 0.5 + (t * t * (3.0 - 2.0 * t) + ku * s) / w12) * texel;
    vec3 rM = S(p12);
    // derivatives of the luma per input texel; the sign of dFdy(uv) makes it a change along +uv.y whatever way the framebuffer runs
    float lM = dot(rM, LUMA);
    vec2 gM = vec2(dFdx(lM) * sign(dFdx(uv.x)) * pc.t0.x, dFdy(lM) * sign(dFdy(uv.y)) * pc.t0.y);
    bool isFlat = abs(gM.x) + abs(gM.y) < pc.t0.w;
    if (isFlat) { oColor = vec4(rM, 1.0); return; }
    vec2 p0 = (f0 - 0.5) * texel;
    vec2 p3 = (f0 + 2.5) * texel;
    vec3 rT = S(vec2(p12.x, p0.y));
    vec3 rL = S(vec2(p0.x, p12.y));
    vec3 rR = S(vec2(p3.x, p12.y));
    vec3 rB = S(vec2(p12.x, p3.y));
    vec2 dn = gM * inversesqrt(dot(gM, gM)) * (pc.t1.w * texel);
    vec3 ra = S(uv - dn);
    vec3 rb = S(uv + dn);
    mediump vec3 hM = rM;
    mediump vec3 hA = ra;
    mediump vec3 hB = rb;
    mediump vec3 hTop = rT;
    mediump vec3 hLeft = rL;
    mediump vec3 hRight = rR;
    mediump vec3 hBottom = rB;
    mediump vec2 hu = ku;
    mediump vec2 hs = s;
    mediump vec2 ht = t;
    mediump vec2 h12 = w12;
    mediump vec3 K = (h12.x * (h12.y * hM - hu.y * (hs.y * hTop + ht.y * hBottom)) - h12.y * hu.x * (hs.x * hLeft + ht.x * hRight)) / (1.0 - hu.x * hu.y);
    mediump vec3 D = K - 0.5 * (hA + hB);
    mediump float hg = pc.t1.x;
    mediump float hw = pc.t1.y;
    mediump vec3 R = K + hg * D + hw * (D - vec3(dot(D, LUMA)));
    mediump vec3 mn = min(hM, min(hA, hB));
    mediump vec3 mx = max(hM, max(hA, hB));
    mediump float hl = pc.t1.z;
    mediump vec3 mg = (mx - mn) * hl;
    oColor = vec4(clamp(R, max(mn - mg, vec3(0.0)), mx + mg), 1.0);
}
